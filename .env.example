# Web auth
APP_PASSWORD=changeme
SESSION_SECRET=changeme
WEB_ORIGIN=http://localhost:3000

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL_FAST=claude-haiku-4-5

# Telegram (HAB7BOT_-prefixed: this .env lives in a shared env_sync.py master
# alongside several other Telegram bots' credentials)
HAB7BOT_TELEGRAM_TOKEN=
HAB7BOT_ALLOWED_USER_ID=

# Planning
WEEK_START_DAY=monday

# Google Calendar + Tasks sync (see SPEC.md §5). GOOGLE_CLIENT_SECRET_PATH
# defaults to a pre-existing OAuth client if unset; GOOGLE_TOKEN_PATH is
# written by `python -m scripts.google_oauth_setup` (run locally, once).
GOOGLE_CLIENT_SECRET_PATH=
GOOGLE_TOKEN_PATH=
